CREATE TABLE Profile (
id INTEGER PRIMARY KEY NOT NULL,
name TEXT NOT NULL,
createdAt TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
themeMode TEXT NOT NULL DEFAULT 'system',
colorTheme TEXT NOT NULL DEFAULT 'dynamic',
priority INTEGER NOT NULL DEFAULT 0,
isPrivate INTEGER NOT NULL DEFAULT 0,
UNIQUE(name, isPrivate)
);

CREATE INDEX IF NOT EXISTS idx_profile_priority_createdAt
ON Profile(priority, createdAt);

CREATE TABLE Deepr (
id INTEGER PRIMARY KEY NOT NULL,
link TEXT NOT NULL,
name TEXT NOT NULL DEFAULT '',
createdAt TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
openedCount INTEGER NOT NULL DEFAULT 0,
isFavourite INTEGER NOT NULL DEFAULT 0,
notes TEXT NOT NULL DEFAULT '',
thumbnail TEXT NOT NULL DEFAULT '',
profileId INTEGER NOT NULL DEFAULT 1,
FOREIGN KEY (profileId) REFERENCES Profile(id) ON DELETE CASCADE
);

-- isGlobal = 1 means the tag is global and visible from every profile.
-- isGlobal = 0 means the tag is visible only from the profiles it is bound to in TagProfiles.
CREATE TABLE Tags (
id INTEGER PRIMARY KEY NOT NULL,
name TEXT NOT NULL,
isPrivate INTEGER NOT NULL DEFAULT 0,
isGlobal INTEGER NOT NULL DEFAULT 1,
UNIQUE(name, isPrivate)
);

CREATE TABLE TagProfiles (
tagId INTEGER NOT NULL,
profileId INTEGER NOT NULL,
PRIMARY KEY (tagId, profileId),
FOREIGN KEY (tagId) REFERENCES Tags(id) ON DELETE CASCADE,
FOREIGN KEY (profileId) REFERENCES Profile(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_tagprofiles_profileId
ON TagProfiles(profileId);

CREATE TABLE LinkTags (
linkId INTEGER NOT NULL,
tagId INTEGER NOT NULL,
PRIMARY KEY (linkId, tagId),
FOREIGN KEY (linkId) REFERENCES Deepr(id) ON DELETE CASCADE,
FOREIGN KEY (tagId) REFERENCES Tags(id) ON DELETE CASCADE
);

CREATE TABLE DeeprOpenLog (
id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
deeplinkId INTEGER NOT NULL,
openedAt TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
FOREIGN KEY (deeplinkId) REFERENCES Deepr(id) ON DELETE CASCADE
);

lastInsertRowId:
SELECT last_insert_rowid();

insertDeepr:
INSERT INTO Deepr (link, name, openedCount, notes, thumbnail, isFavourite, profileId) VALUES (?, ?, ?, ?, ?, ?, ?);

importDeepr:
INSERT INTO Deepr (link, name, openedCount, notes, thumbnail, isFavourite, createdAt, profileId) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getLinksAndTags:
SELECT
  Deepr.id AS id,
  Deepr.link,
  Deepr.name,
  Deepr.createdAt,
  Deepr.openedCount,
  Deepr.isFavourite,
  Deepr.notes,
  Deepr.thumbnail,
  Deepr.profileId,
  DOL_Max.lastOpenedAt,
  GROUP_CONCAT(Tags.name, ', ') AS tagsNames,
  GROUP_CONCAT(Tags.id, ', ') AS tagsIds
FROM
  Deepr
  LEFT JOIN (
        -- Subquery to find the single latest log entry per deeplink
        SELECT
          deeplinkId,
          MAX(openedAt) AS lastOpenedAt
        FROM
          DeeprOpenLog
        GROUP BY
          deeplinkId
      ) AS DOL_Max ON Deepr.id = DOL_Max.deeplinkId
  LEFT JOIN LinkTags ON Deepr.id = LinkTags.linkId
  LEFT JOIN Tags ON LinkTags.tagId = Tags.id
  LEFT JOIN Profile ON Deepr.profileId = Profile.id
WHERE
  (
    (
      :globalSearch = 0 AND Deepr.profileId = ?
    )
    OR (
      :globalSearch = 1 AND Profile.isPrivate = 0
    )
  )
  AND (Deepr.link LIKE '%' || ? || '%' OR Deepr.name LIKE '%' || ? || '%' OR Deepr.notes LIKE '%' || ? || '%' OR EXISTS (SELECT 1 FROM LinkTags, Tags WHERE LinkTags.tagId = Tags.id AND LinkTags.linkId = Deepr.id AND Tags.name LIKE '%' || ? || '%'))
  AND (
    ? = -1 OR Deepr.isFavourite = ?
  )
  AND (
    ? = '' OR (
      SELECT COUNT(DISTINCT lt.tagId)
      FROM LinkTags lt
      WHERE lt.linkId = Deepr.id
        AND (',' || ? || ',' LIKE '%,' || CAST(lt.tagId AS TEXT) || ',%')
    ) > 0
  )
GROUP BY
  Deepr.id
ORDER BY
    CASE WHEN ? = 'ASC' THEN
        CASE ?
            WHEN 'createdAt' THEN Deepr.createdAt
            WHEN 'openedCount' THEN Deepr.openedCount
            WHEN 'name' THEN Deepr.name
            WHEN 'link' THEN Deepr.link
            ELSE Deepr.createdAt
        END
    END ASC,
    CASE WHEN ? = 'DESC' THEN
        CASE ?
            WHEN 'createdAt' THEN Deepr.createdAt
            WHEN 'openedCount' THEN Deepr.openedCount
            WHEN 'name' THEN Deepr.name
            WHEN 'link' THEN Deepr.link
            ELSE Deepr.createdAt
        END
    END DESC;

getProfilesForBackup:
SELECT * FROM Profile WHERE isPrivate = 0 ORDER BY priority ASC, createdAt ASC;

getLinksForBackup:
SELECT
  D.id,
  D.link,
  D.name,
  D.createdAt,
  D.openedCount,
  D.isFavourite,
  D.notes,
  D.thumbnail,
  D.profileId,
  P.name AS profileName,
  P.priority AS profilePriority,
  DOL_Max.lastOpenedAt,
  GROUP_CONCAT(T.name, ', ') AS tags
FROM Deepr AS D
JOIN Profile AS P ON D.profileId = P.id
LEFT JOIN (
      SELECT
        deeplinkId,
        MAX(openedAt) AS lastOpenedAt
      FROM
        DeeprOpenLog
      GROUP BY
        deeplinkId
    ) AS DOL_Max ON D.id = DOL_Max.deeplinkId
LEFT JOIN LinkTags AS LT ON D.id = LT.linkId
LEFT JOIN Tags AS T ON LT.tagId = T.id
WHERE P.isPrivate = 0
GROUP BY
  D.id;


listDeeprAsc:
SELECT * FROM Deepr ORDER BY createdAt ASC;

listDeeprWithTagsAsc:
SELECT
  Deepr.id AS id,
  Deepr.link,
  Deepr.name,
  Deepr.createdAt,
  Deepr.openedCount,
  Deepr.notes,
  Deepr.thumbnail,
  Deepr.isFavourite,
  DOL_Max.lastOpenedAt,
  GROUP_CONCAT(Tags.name, ', ') AS tagsNames
FROM
  Deepr
  JOIN Profile ON Deepr.profileId = Profile.id
  LEFT JOIN (
      -- Subquery to find the single latest log entry per deeplink
      SELECT
        deeplinkId,
        MAX(openedAt) AS lastOpenedAt
      FROM
        DeeprOpenLog
      GROUP BY
        deeplinkId
    ) AS DOL_Max ON Deepr.id = DOL_Max.deeplinkId
  LEFT JOIN LinkTags ON Deepr.id = LinkTags.linkId
  LEFT JOIN Tags ON LinkTags.tagId = Tags.id
WHERE Profile.isPrivate = 0
GROUP BY
  Deepr.id
ORDER BY
  Deepr.createdAt ASC;

deleteDeeprById:
DELETE FROM Deepr WHERE id = ?;

incrementOpenedCount:
UPDATE Deepr SET openedCount = openedCount + 1 WHERE id = ?;

resetOpenedCount:
UPDATE Deepr SET openedCount = 0 WHERE id = ?;

updateDeeplink:
UPDATE Deepr SET link = ? , name = ?, notes = ?, thumbnail = ?, isFavourite = ?, profileId = ? WHERE id = ?;

countDeepr:
SELECT COUNT(*) FROM Deepr;

getDeeprByLink:
SELECT * FROM Deepr WHERE link = ?;

getDeeprById:
SELECT * FROM Deepr WHERE id = ?;


-- Tag operations
insertTag:
INSERT OR IGNORE INTO Tags (name, isPrivate, isGlobal) VALUES (?, ?, ?);

getTagByName:
SELECT * FROM Tags WHERE name = :name AND isPrivate = :isPrivate;

getTagById:
SELECT * FROM Tags WHERE id = ?;

-- Global tags (isGlobal = 1) plus the ones bound to the given profile in TagProfiles
getAllTags:
SELECT DISTINCT Tags.* FROM Tags
LEFT JOIN TagProfiles ON Tags.id = TagProfiles.tagId
WHERE Tags.isPrivate = :isPrivate
  AND (Tags.isGlobal = 1 OR TagProfiles.profileId = :profileId)
ORDER BY Tags.name;

listAllTagsAsc:
SELECT * FROM Tags ORDER BY name ASC;

listAllLinkTags:
SELECT * FROM LinkTags;

getAllTagsWithCount:
SELECT 
  Tags.id,
  Tags.name,
  Tags.isGlobal,
  COUNT(DISTINCT LinkTags.linkId) AS linkCount
FROM Tags
LEFT JOIN LinkTags ON Tags.id = LinkTags.tagId
WHERE Tags.isPrivate = :isPrivate
GROUP BY Tags.id, Tags.name, Tags.isGlobal
ORDER BY linkCount DESC, Tags.name;

countOfLinks:
SELECT count(*) FROM Deepr WHERE profileId = ?;

countOfFavouriteLinks:
SELECT count(*) FROM Deepr WHERE isFavourite = 1 AND profileId = ?;


-- Link-Tag relations
addTagToLink:
INSERT OR IGNORE INTO LinkTags (linkId, tagId) VALUES (?, ?);

removeTagFromLink:
DELETE FROM LinkTags WHERE linkId = ? AND tagId = ?;

deleteLinkRelations:
DELETE FROM LinkTags WHERE linkId = ?;


deleteTag:
DELETE FROM Tags WHERE id = ?;

deleteTagRelations:
DELETE FROM LinkTags WHERE tagId = ?;

-- Tags bound to a profile are removed together with the profile itself only if not global and not bound to any other profile
deleteTagsForProfile:
DELETE FROM Tags
WHERE isGlobal = 0
  AND id IN (SELECT tagId FROM TagProfiles WHERE profileId = :profileId)
  AND id NOT IN (SELECT tagId FROM TagProfiles WHERE profileId != :profileId);

updateTag:
UPDATE Tags SET name = ?, isGlobal = ? WHERE id = ?;

getTagsForLink:
SELECT Tags.* FROM Tags INNER JOIN LinkTags ON Tags.id = LinkTags.tagId WHERE LinkTags.linkId = ? ORDER BY Tags.name;

hasTagLinks:
SELECT COUNT(*) FROM LinkTags WHERE tagId = ?;

-- TagProfiles operations
insertTagProfile:
INSERT OR IGNORE INTO TagProfiles (tagId, profileId) VALUES (?, ?);

deleteTagProfiles:
DELETE FROM TagProfiles WHERE tagId = ?;

deleteTagProfile:
DELETE FROM TagProfiles WHERE tagId = ? AND profileId = ?;

getProfilesForTag:
SELECT profileId FROM TagProfiles WHERE tagId = ?;

getAllTagProfiles:
SELECT * FROM TagProfiles;

-- Deeplink Open Log operations
insertDeeprOpenLog:
INSERT INTO DeeprOpenLog (deeplinkId) VALUES (?);

getLastOpenedTime:
SELECT openedAt FROM DeeprOpenLog WHERE deeplinkId = ? ORDER BY openedAt DESC LIMIT 1;

toggleFavourite:
UPDATE Deepr SET isFavourite = CASE WHEN isFavourite = 0 THEN 1 ELSE 0 END WHERE id = ?;

setFavourite:
UPDATE Deepr SET isFavourite = ? WHERE id = ?;

-- Profile operations
insertProfile:
INSERT OR IGNORE INTO Profile (name, isPrivate) VALUES (?, ?);

insertProfileWithPriority:
INSERT OR IGNORE INTO Profile (name, priority, isPrivate) VALUES (?, ?, ?);

insertProfileAutoPriority:
INSERT OR IGNORE INTO Profile (name, priority, isPrivate)
VALUES (?, (SELECT COALESCE(MAX(priority), 0) + 1 FROM Profile), ?);

shiftProfilePriorities:
UPDATE Profile SET priority = priority + 1 WHERE priority >= ?;

getAllProfiles:
SELECT * FROM Profile ORDER BY priority ASC, createdAt ASC;

getProfileById:
SELECT * FROM Profile WHERE id = ?;

getProfileByName:
SELECT * FROM Profile WHERE name = ? AND isPrivate = ?;

updateProfile:
UPDATE Profile SET name = ?, themeMode = ?, colorTheme = ? WHERE id = ?;

updateProfilePriority:
UPDATE Profile SET priority = ? WHERE id = ?;

maxPriority:
SELECT MAX(priority) FROM Profile;

deleteProfile:
DELETE FROM Profile WHERE id = ?;

deleteAllProfiles:
DELETE FROM Profile;

deleteAllTags:
DELETE FROM Tags;

countProfiles:
SELECT COUNT(*) FROM Profile;

